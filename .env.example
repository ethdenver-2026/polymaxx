# === TRADING MODE ===
# paper = simulation only (no real trades)
# live = real trading with wallet (requires wallet setup)
TRADING_MODE=paper

# === POSITION SIZING ===
BANKROLL_USDC=50
MAX_POSITION_USD=5
KELLY_FRACTION=0.25
EDGE_THRESHOLD_PCT=8
DAILY_LOSS_LIMIT_PCT=5

# === API KEYS ===
# Venice.ai API key (OpenAI-compatible LLM)
VENICE_API_KEY=

# Grid API key (optional)
GRID_API_KEY=

# === POLYMARKET CREDENTIALS (Live trading only) ===
# These are only needed when TRADING_MODE=live
# POLYMARKET_PRIVATE_KEY=0x<64-hex-chars>
# POLYMARKET_WALLET_ADDRESS=0x<40-hex-chars>
# POLYMARKET_API_KEY=<derived>
# POLYMARKET_API_SECRET=<derived>
# POLYMARKET_API_PASSPHRASE=<derived>

# === CHAIN CONFIG ===
CHAIN_ID=137
CLOB_API_URL=https://clob.polymarket.com
GAMMA_API_URL=https://gamma-api.polymarket.com

# === FORECAST CONFIG ===
MAX_FORECAST_DAYS=2
